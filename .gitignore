# ---- user data: everything Jarvis learns about YOU stays out of git ----
# Your instance's memory, reports, call recordings, brain vault, and secrets
# live in these directories. The repo ships memory.example/ as the template.
/memory/
/reports/
/brain/
/data/
/secrets/
/models/

# never any secrets, anywhere
*.pem
*.key
.env

# logs
*.log
*.err

# built native helpers (compiled per-machine by install.sh)
tools/call-capture/bin/
tools/call-capture/JarvisAudio.app/

# monorepo build artifacts
node_modules/
apps/server/dist/
apps/web/dist/
*.tsbuildinfo
__pycache__/

# built app bundles (rebuilt by install.sh)
tools/menubar/JarvisBar.app/

# ship the vendored obsidian skills, keep local claude settings out
.claude/*
!.claude/skills/
