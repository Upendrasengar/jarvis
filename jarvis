#!/usr/bin/env bash
# Jarvis · © 2026 Upendra Sengar · MIT License · https://github.com/Upendrasengar/jarvis
# Talk to Jarvis. Usage:
#   jarvis            -> open an interactive Jarvis session (type or /voice)
#   jarvis start      -> start everything: UI + call-notes watcher
#   jarvis stop|restart|status  -> manage those services
#   jarvis digest     -> run today's digest and print it
#   jarvis setup      -> full dependency setup (whisper model download etc.)
#   jarvis logs       -> tail the server / watcher / cron logs
#   jarvis service    -> install|uninstall|status: auto-start at login
#   jarvis upgrade    -> update to the latest release and restart
#   jarvis uninstall  -> remove Jarvis completely (asks about your data)
#   jarvis "what do I know about X"  -> one-shot question
cd "$(dirname "$0")" || exit 1

# first run: seed your private data dirs from the shipped templates
if [[ ! -d memory ]]; then
  cp -R memory.example memory
  mkdir -p reports brain secrets data
  echo "jarvis: created memory/ from memory.example — edit memory/about-me.md"
  echo "        and memory/active-projects.md (or just tell Jarvis who you are)."
fi

if [[ $# -eq 0 ]]; then
  exec claude          # interactive: type, or hold space for voice
elif [[ "$1" == "start" || "$1" == "stop" || "$1" == "restart" || "$1" == "status" ]]; then
  exec bash tools/services.sh "$1"
elif [[ "$1" == "ui" ]]; then
  exec bash tools/services.sh start
elif [[ "$1" == "digest" ]]; then
  exec bash tools/run-digest.sh
elif [[ "$1" == "doctor" ]]; then
  exec bash install.sh --check
elif [[ "$1" == "telegram" ]]; then
  exec bash tools/setup-telegram.sh
elif [[ "$1" == "init" ]]; then
  exec bash tools/init.sh
elif [[ "$1" == "setup" ]]; then
  bash install.sh || exit $?
  # offer auto-start at login (skipped when non-interactive)
  if [ -t 0 ]; then
    printf "Start Jarvis automatically at login (runs as a background service)? [y/N] "
    read -r yn
    case "$yn" in [Yy]*) bash tools/service.sh install ;; esac
  fi
  exit 0
elif [[ "$1" == "service" ]]; then
  shift
  exec bash tools/service.sh "$@"
elif [[ "$1" == "upgrade" ]]; then
  if [[ -L node_modules ]]; then
    brew update && brew upgrade jarvis
    exec bash tools/services.sh restart
  else
    git pull --ff-only && pnpm install && (cd apps/web && pnpm exec vite build)
    exec bash tools/services.sh restart
  fi
elif [[ "$1" == "uninstall" ]]; then
  exec bash tools/uninstall.sh
elif [[ "$1" == "logs" ]]; then
  echo "── server (reports/api.log) ──"; tail -20 reports/api.log 2>/dev/null || echo "(none yet)"
  echo; echo "── call watcher (reports/callwatch.log) ──"; tail -12 reports/callwatch.log 2>/dev/null || echo "(none yet)"
  echo; echo "── digest cron (reports/cron.log) ──"; tail -8 reports/cron.log 2>/dev/null || echo "(none yet)"
  exit 0
else
  exec claude -p "$*" --model sonnet
fi
