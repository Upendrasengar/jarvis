#!/usr/bin/env bash
# Jarvis · © 2026 Upendra Sengar · MIT License · https://github.com/Upendrasengar/jarvis
# Talk to Jarvis. Usage:
#   jarvis            -> open an interactive Jarvis session (type or /voice)
#   jarvis start      -> start everything: UI + call-notes watcher
#   jarvis stop|restart|status  -> manage those services
#   jarvis digest     -> run today's digest and print it
#   jarvis setup      -> full dependency setup (whisper model download etc.)
#   jarvis doctor [--json] -> read-only health report
#   jarvis onboard [--non-interactive] -> resumable first-run setup
#   jarvis model [size] -> list transcription models, or pick+download one
#   jarvis sign [create] -> stable code-signing identity (keeps mac permissions)
#   jarvis logs       -> tail the server / watcher / cron logs
#   jarvis service    -> install|uninstall|status: auto-start at login
#   jarvis bar        -> open the menu-bar icon (status + record controls)
#   jarvis vault [path] -> migrate to the unified Obsidian vault (default ~/Jarvis)
#   jarvis upgrade    -> update to the latest release and restart
#   jarvis uninstall  -> remove Jarvis completely (asks about your data)
#   jarvis "what do I know about X"  -> one-shot question
cd "$(dirname "$0")" || exit 1

# Doctor must be read-only, including on a first run. Dispatch it before the
# private-data seeding performed by interactive commands.
if [[ "${1:-}" == "doctor" ]]; then
  shift
  exec bash tools/doctor.sh "$@"
elif [[ "${1:-}" == "onboard" ]]; then
  shift
  exec bash tools/onboard.sh "$@"
fi

# first run: seed your private data dirs from the shipped templates
if [[ ! -d memory ]]; then
  cp -R memory.example memory
  mkdir -p reports brain secrets data
  echo "jarvis: created memory/ from memory.example — edit memory/about-me.md"
  echo "        and memory/active-projects.md (or just tell Jarvis who you are)."
fi

if [[ $# -eq 0 ]]; then
  exec claude          # interactive: type, or hold space for voice
elif [[ "$1" == "start" ]]; then
  bash tools/services.sh start
  # the menu-bar icon rides along when it's built
  [[ -d tools/menubar/JarvisBar.app ]] && ! pgrep -qf JarvisBar.app && open -g -a "$PWD/tools/menubar/JarvisBar.app" 2>/dev/null
  exit 0
elif [[ "$1" == "stop" ]]; then
  pkill -f JarvisBar.app 2>/dev/null
  exec bash tools/services.sh stop
elif [[ "$1" == "restart" || "$1" == "status" ]]; then
  exec bash tools/services.sh "$1"
elif [[ "$1" == "ui" ]]; then
  exec bash tools/services.sh start
elif [[ "$1" == "digest" ]]; then
  exec bash tools/run-digest.sh
elif [[ "$1" == "telegram" ]]; then
  exec bash tools/setup-telegram.sh
elif [[ "$1" == "init" ]]; then
  exec bash tools/init.sh
elif [[ "$1" == "sign" ]]; then
  # A stable signing identity is what stops every rebuild revoking the
  # recording permissions macOS grants to Jarvis Audio.
  exec bash tools/signing-identity.sh "${2:-status}"
elif [[ "$1" == "model" ]]; then
  # Picking a transcription model and HAVING it were separate things: the
  # setting chose which file to load, `jarvis setup` only downloaded when
  # models/ was empty, and nothing connected the two. Selecting a size you
  # did not have on disk left the next call failing its preflight.
  exec bash tools/whisper-model.sh "${2:-}"
elif [[ "$1" == "setup" ]]; then
  bash install.sh || exit $?
  # offer auto-start at login (skipped when non-interactive)
  if [ -t 0 ]; then
    printf "Start Jarvis automatically at login (runs as a background service)? [y/N] "
    read -r yn
    case "$yn" in [Yy]*) bash tools/service.sh install ;; esac
  fi
  exit 0
elif [[ "$1" == "vault" ]]; then
  shift
  bash tools/migrate-vault.sh "$@" && exec bash tools/services.sh restart
elif [[ "$1" == "bar" ]]; then
  [[ -d tools/menubar/JarvisBar.app ]] || { echo "not built yet — run: jarvis setup"; exit 1; }
  exec open -g -a "$PWD/tools/menubar/JarvisBar.app"
elif [[ "$1" == "service" ]]; then
  shift
  exec bash tools/service.sh "$@"
elif [[ "$1" == "upgrade" ]]; then
  if [[ -L node_modules ]]; then
    brew update && brew upgrade jarvis
    exec bash tools/services.sh restart
  else
    git pull --ff-only && pnpm install && (cd apps/web && pnpm exec vite build)
    exec bash tools/services.sh restart
  fi
elif [[ "$1" == "uninstall" ]]; then
  exec bash tools/uninstall.sh
elif [[ "$1" == "logs" ]]; then
  echo "── server (reports/api.log) ──"; tail -20 reports/api.log 2>/dev/null || echo "(none yet)"
  echo; echo "── call watcher (reports/callwatch.log) ──"; tail -12 reports/callwatch.log 2>/dev/null || echo "(none yet)"
  echo; echo "── digest cron (reports/cron.log) ──"; tail -8 reports/cron.log 2>/dev/null || echo "(none yet)"
  exit 0
else
  exec claude -p "$*" --model sonnet
fi
